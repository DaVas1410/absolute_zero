{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "algoworks-rfp-backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": ["run", "--directory", "backend", "uvicorn", "api.main:app", "--port", "8000"],
      "port": 8000
